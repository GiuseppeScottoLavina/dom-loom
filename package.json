{
  "name": "dom-loom",
  "version": "0.3.0",
  "type": "module",
  "description": "Game-feel UI for plain HTML, drawn by WebGPU: presses dent, panels shatter, tabs cut like a blade. Web components on HTML-in-Canvas.",
  "keywords": [
    "webgpu",
    "html-in-canvas",
    "web-components",
    "custom-elements",
    "game-ui",
    "ui-library",
    "ui-components",
    "animation",
    "motion",
    "shaders",
    "wgsl",
    "forms",
    "accessibility",
    "page-transitions",
    "view-transitions",
    "react",
    "vue",
    "gamedev"
  ],
  "license": "MIT",
  "author": "Giuseppe Scotto Lavina",
  "homepage": "https://giuseppescottolavina.github.io/dom-loom/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GiuseppeScottoLavina/dom-loom.git"
  },
  "bugs": {
    "url": "https://github.com/GiuseppeScottoLavina/dom-loom/issues"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./core": {
      "types": "./types/core.d.ts",
      "default": "./src/core/index.js"
    },
    "./react": {
      "types": "./types/react.d.ts",
      "default": "./src/react/index.js"
    },
    "./vue": {
      "types": "./types/vue.d.ts",
      "default": "./src/vue/index.js"
    },
    "./style.css": "./src/loom.css",
    "./base.css": "./src/base.css",
    "./skins/holo.css": "./src/skins/holo/holo.css",
    "./skins/holo/*.css": "./src/skins/holo/*.css",
    "./primitives/*": {
      "types": "./types/primitives/*.d.ts",
      "default": "./src/primitives/*.js"
    },
    "./package.json": "./package.json",
    "./*": {
      "types": "./types/component.d.ts",
      "default": "./src/components/*.js"
    }
  },
  "files": [
    "src",
    "types",
    "skills/domloom/SKILL.md"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test test/*.test.mjs",
    "test:browser": "node test/stage.browser.mjs",
    "test:app": "node test/app.browser.mjs",
    "test:dialog": "node test/dialog.browser.mjs",
    "test:page": "node test/page.browser.mjs",
    "test:startup": "node test/startup.browser.mjs",
    "test:effects": "node test/effects.browser.mjs",
    "test:guide": "node test/guide.browser.mjs",
    "test:types": "tsc -p test/types",
    "test:visual": "node test/visual.mjs"
  },
  "dependencies": {
    "@giuseppe-scotto-lavina/html-in-canvas-polyfill": "^1.0.4"
  },
  "devDependencies": {
    "@fontsource-variable/big-shoulders-display": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "playwright-core": "1.62.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "typescript": "5.8.3",
    "vite": "7.3.7",
    "vue": "3.5.45"
  },
  "sideEffects": [
    "*.css",
    "./src/index.js",
    "./src/core/index.js",
    "./src/components/*.js",
    "./src/skins/**/*.js",
    "./src/primitives/*.js",
    "./src/react/index.js",
    "./src/vue/index.js"
  ],
  "types": "./types/index.d.ts",
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  }
}
